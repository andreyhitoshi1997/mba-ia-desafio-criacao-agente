GOOGLE_API_KEY=

# Modelo Gemini padrão para os três agentes. Pode ser sobrescrito por agente
# com AURORA_MODEL_ROOT, AURORA_MODEL_AGENDA, AURORA_MODEL_REGULAMENTO.
# gemini-2.5-flash-lite: tier gratuito com RPM bem mais folgado que
# gemini-2.5-flash — importa porque o fluxo do avaliador faz várias dezenas
# de chamadas ao modelo numa janela curta de tempo.
AURORA_MODEL=gemini-2.5-flash-lite
