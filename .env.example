GOOGLE_API_KEY=

# Modelo Gemini padrão para os três agentes. Pode ser sobrescrito por agente
# com AURORA_MODEL_ROOT, AURORA_MODEL_AGENDA, AURORA_MODEL_REGULAMENTO.
# gemini-flash-lite-latest: alias que sempre aponta para o flash-lite mais
# recente disponível (evita apontar para um modelo específico que pode ser
# descontinuado, como aconteceu com a série 2.0) e teve, nos nossos testes,
# cota de tier gratuito mais folgada que gemini-2.5-flash-lite — relevante
# porque o fluxo do avaliador faz várias dezenas de chamadas ao modelo numa
# janela curta de tempo. Troque para um modelo fixo (ex.: gemini-2.5-flash)
# se preferir estabilidade de versão a always-latest.
AURORA_MODEL=gemini-flash-lite-latest
